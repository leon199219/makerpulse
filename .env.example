# Copy this file to .env and fill in your values.
# .env is gitignored and must not be committed.
# See SECURITY.md.
#
# Docker Compose loads `.env` for ${variable} substitution in compose files.
# In this repo that applies to MAKERPULSE_PORT and (in docker-compose.image.yml)
# MAKERPULSE_IMAGE. The other names are what the app (or the Postgres
# service) reads. To pass them into a container, set them under
# `environment:` in your compose file, or change those lines to ${VAR}.
#
# Change the default database password (makerpulse:makerpulse) before
# you use this outside a local demo.

# --- App (read by the server) ---

# Required. Postgres URL. The host is the Compose service name, not localhost.
DATABASE_URL=postgres://makerpulse:change-me@db:5432/makerpulse

# Numeric MakerWorld user ID (or set it later in Settings).
MAKERWORLD_UID=

# Optional MakerWorld handle. The app can also store this from Settings.
MAKERWORLD_HANDLE=

# Starting poll interval in minutes (30). After you save Settings, that value is used.
POLL_INTERVAL_MINUTES=30

# Optional Telegram bot. Leave empty to set them in Settings instead.
# Token from https://t.me/BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Starting value only: hourly, every_6h, daily, or weekly.
# After you save Settings, that choice is used.
TELEGRAM_CADENCE=daily

# Optional shared secret for GET /api/cron. Leave empty to leave the endpoint open.
CRON_SECRET=

# --- Compose / Postgres ---

# Host port mapped to container port 8080 (standalone compose files).
# This one is substituted from `.env` as ${MAKERPULSE_PORT:-8080}.
MAKERPULSE_PORT=8080

# Image override for docker-compose.image.yml only (${MAKERPULSE_IMAGE:-...}).
# Example: makerpulse:1.0
# Default is ghcr.io/leon199219/makerpulse:latest
# MAKERPULSE_IMAGE=ghcr.io/leon199219/makerpulse:latest

# Used by the bundled Postgres service. Must match DATABASE_URL.
# The compose files in this repo hardcode these unless you change them.
POSTGRES_USER=makerpulse
POSTGRES_PASSWORD=change-me
POSTGRES_DB=makerpulse

# --- Auth / platform (usually leave unset for self-hosting) ---
# The published Docker image sets VITE_AUTH_ENABLED=false.
# The other names are read by the app code, but a self-hosted
# install does not need them.

# Set to false to keep sign-in off (the Docker default).
# VITE_AUTH_ENABLED=false

# GROK_PROJECT_ID=
# GROK_GATE_ORIGIN=
# GROK_AUTH_ISSUER=
# GROK_AUTH_CLIENT_ID=
# GROK_AUTH_CLIENT_SECRET=
# GROK_CONNECTORS_URL=
# GROK_CONNECTOR_ACCESS_TOKEN=
# BETTER_AUTH_URL=
# BETTER_AUTH_SECRET=
